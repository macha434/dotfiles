{
    "id": "macha-features",
    "version": "0.5.2",
    "name": "Persistent agent state volume",
    "description": "Keeps ~/.claude and ~/.codex in a named volume shared across dev containers, and optionally installs the agent CLIs.",
    "documentationURL": "https://github.com/macha434/dotfiles/tree/main/features/src/macha-features",
    "options": {
        "claude": {
            "type": "boolean",
            "default": true,
            "description": "Install the Claude Code CLI and apply the status line"
        },
        "codex": {
            "type": "boolean",
            "default": false,
            "description": "Install the Codex CLI"
        }
    },
    "mounts": [
        {
            "source": "agent-state",
            "target": "/var/lib/agent-state",
            "type": "volume"
        }
    ],
    "entrypoint": "/usr/local/share/macha-features/entrypoint.sh",
    "postCreateCommand": "/usr/local/share/macha-features/ensure-codex.sh"
}
