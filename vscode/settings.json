{
    // ===== Dev Containers =====
    "dev.containers.defaultFeatures":{
        "ghcr.io/macha434/dotfiles/macha-features:latest": {
            "claude": true,
            "codex": false
        }
    },

    // ===== プライバシー / テレメトリ（送信しない） =====
    "telemetry.telemetryLevel": "off",
    "workbench.enableExperiments": false,

    // ===== セキュリティ（ワークスペースの信頼） =====
    "security.workspace.trust.untrustedFiles": "prompt",

    // ===== ファイルの保存 =====
    // 編集の手が止まった直後に保存する
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 100,
    // 自動保存でも末尾の空白は除去される (編集中の行だけは残る)
    "files.trimTrailingWhitespace": true,

    // ===== エディタ: フォント =====
    "editor.fontFamily": "'JetBrains Mono', 'Fira Code', Consolas, monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,

    // ===== エディタ: カーソル / 複数選択 =====
    "editor.cursorStyle": "underline-thin",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.multiCursorModifier": "ctrlCmd",

    // ===== エディタ: 表示（不可視文字・折り返し・余計な UI を減らす） =====
    "editor.renderWhitespace": "trailing",
    "editor.renderControlCharacters": true,
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "editor.smoothScrolling": true,
    "editor.hover.above": false,
    "breadcrumbs.enabled": true,

    // ===== エディタ: 補完・サジェスト =====
    "editor.snippetSuggestions": "inline",
    "editor.tabCompletion": "off",

    // ===== エディタ: 自動フォーマット =====
    // 注: files.autoSave が afterDelay の間、formatOnSave は発火しない
    //     (VS Code は自動保存では整形をスキップする)。
    //     保存時の整形が必要になったら autoSave を onFocusChange に戻すこと。
    //     手動整形は shift+alt+f。
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,

    // ===== 差分表示 =====
    "diffEditor.codeLens": true,
    "diffEditor.renderSideBySide": true,
    "diffEditor.wordWrap": "on",

    // ===== ウィンドウ / UI レイアウト =====
    "window.titleBarStyle": "custom",
    "window.menuBarVisibility": "compact",
    "window.commandCenter": true,
    "workbench.colorTheme": "Dark Modern",
    "workbench.startupEditor": "none",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.editor.useModal": "off",
    // グループ内の最後のタブを閉じたら、その分割自体を畳む
    "workbench.editor.closeEmptyGroups": true,
    "workbench.list.smoothScrolling": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",

    // ===== コマンドパレット =====
    "workbench.commandPalette.history": 1000,
    "workbench.commandPalette.preserveInput": true,

    // ===== 検索 =====
    "search.exclude": {
        "**/node_modules/**": true
    },

    // ===== エクスプローラー =====
    // 削除は keybindings.json で 1 打鍵の "d" に割り当てているため確認を出す
    "explorer.confirmDelete": true,
    "explorer.confirmDragAndDrop": false,

    // ===== Git / ソース管理 =====
    "git.autofetch": true,
    "git.confirmSync": true,
    "git.confirmForcePush": true,
    "git.suggestSmartCommit": false,
    "git.ignoreRebaseWarning": true,
    "git.openRepositoryInParentFolders": "always",
    // stage / unstage / commit / stash / 破棄 のあとに、その操作対象の
    // エディタを閉じる。
    "git.closeDiffOnOperation": true,
    "scm.defaultViewMode": "tree",

    // ===== Notebook / Markdown =====
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "markdown.preview.breaks": true,

    // ===== AI / チャット =====
    "github.copilot.nextEditSuggestions.enabled": true,
    "claudeCode.preferredLocation": "panel",
    "chat.mcp.gallery.enabled": true,
    "chat.viewSessions.orientation": "stacked",

    // ===== 拡張機能 / リモート開発 =====
    "extensions.autoUpdate": "on",
    "dev.containers.executeInWSL": true,

    // ===== Vim: キーマップ =====
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "vim.normalModeKeyBindings": [
        {
            "before": [
                "J"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "j"
            ]
        },
        {
            "before": [
                "K"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "k"
            ]
        },
        {
            "before": [
                "W"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "w"
            ]
        },
        {
            "before": [
                "E"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "e"
            ]
        },
        {
            "before": [
                "B"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "b"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<space>",
                "r"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
        {
            "before": [
                "<space>",
                "d"
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        {
            "before": [
                "<space>",
                "t"
            ],
            "commands": [
                "editor.action.goToTypeDefinition"
            ]
        },
        {
            "before": [
                "<space>",
                "h"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        },
        {
            "before": [
                "<space>",
                "a"
            ],
            "commands": [
                "code-runner.run"
            ]
        }
    ],
    "vim.visualModeKeyBindings": [
        {
            "before": [
                "J"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "j"
            ]
        },
        {
            "before": [
                "K"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "k"
            ]
        },
        {
            "before": [
                "W"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "w"
            ]
        },
        {
            "before": [
                "E"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "e"
            ]
        },
        {
            "before": [
                "B"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "b"
            ]
        }
    ],

    // ===== Vim: 動作・プラグイン =====
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.autoindent": true,
    "vim.surround": true,
    "vim.easymotion": true,
    "vim.camelCaseMotion.enable": true,
    "vim.visualstar": true,

    // ===== Vim: 検索 =====
    "vim.hlsearch": true,
    "vim.ignorecase": true,
    "vim.incsearch": true,

    // ===== Vim: 表示（モードごとの statusbar 色） =====
    "vim.highlightedyank.enable": true,
    "vim.statusBarColorControl": true,

    // ===== 通知音・アナウンス（すべて無効） =====
    "accessibility.signals.chatRequestSent": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.clear": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.notebookCellCompleted": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.notebookCellFailed": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.taskCompleted": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.taskFailed": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.terminalQuickFix": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.terminalCommandFailed": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.terminalBell": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.lineHasError": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.lineHasWarning": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.lineHasFoldedArea": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.lineHasBreakpoint": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.lineHasInlineSuggestion": {
        "sound": "off"
    },
    "accessibility.signals.diffLineModified": {
        "sound": "off"
    },
    "accessibility.signals.diffLineInserted": {
        "sound": "off"
    },
    "accessibility.signals.diffLineDeleted": {
        "sound": "off"
    },
    "accessibility.signals.codeActionApplied": {
        "sound": "off"
    },
    "accessibility.signals.codeActionTriggered": {
        "sound": "off"
    },
    "accessibility.signals.progress": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.onDebugBreak": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.noInlayHints": {
        "sound": "off",
        "announcement": "off"
    }
}