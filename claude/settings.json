{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh",
    "hideVimModeIndicator": true
  },
  "extraKnownMarketplaces": {
    "macha434-plugins": {
      "source": {
        "source": "github",
        "repo": "macha434/lean"
      }
    }
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "fastMode": false,
  "fastModePerSessionOptIn": true,
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "lean@macha434-plugins": true
  }
}
